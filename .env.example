# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Create a bot with @BotFather and paste the HTTP API token here.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional but strongly recommended. Telegram sends this value back in the
# X-Telegram-Bot-Api-Secret-Token header and the webhook rejects any request
# that does not match. Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=

# Public base URL of the deployment (no trailing slash). Used by the
# `npm run webhook:set` helper so you do not have to type the URL twice.
# Example: https://my-digital-store.vercel.app
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Turso (libSQL)
# ---------------------------------------------------------------------------
# turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
SHOP_NAME=Digital Store
CURRENCY=BDT
CURRENCY_SYMBOL=৳
SUPPORT_USERNAME=

# ---------------------------------------------------------------------------
# Manual payment defaults
# These are only fallback values. An admin can change all of them at runtime
# from the bot: /admin -> Settings, and the bot database wins over this file.
# ---------------------------------------------------------------------------
PAYMENT_METHOD_NAME=bKash
PAYMENT_NUMBER=01XXXXXXXXX
PAYMENT_INSTRUCTIONS=Send Money only (do not use Cash Out or Payment).
PAYMENT_NOTE=Send the exact amount, then submit the Transaction ID (TrxID) from the confirmation SMS.

# ---------------------------------------------------------------------------
# Admins
# Comma separated Telegram numeric user IDs. Send /id to the bot to learn
# your own ID. Admins added here are always admins; more can be added from
# /admin -> Admins and are stored in the database.
# ---------------------------------------------------------------------------
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
PRODUCTS_PER_PAGE=8
ORDERS_PER_PAGE=8
